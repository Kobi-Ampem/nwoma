<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<style>
  @page { size: A4; margin: 16mm 15mm; }
  body { font-family: "DejaVu Sans", sans-serif; font-size: 9.5pt; color: #111; }
  header { border-bottom: 2px solid #111; padding-bottom: 3mm; margin-bottom: 5mm; }
  h1 { font-size: 15pt; margin: 0; }
  .sub { font-size: 9pt; color: #444; }
  table { width: 100%; border-collapse: collapse; }
  .meta td { padding: 1mm 0; width: 50%; }
  .results { margin-top: 5mm; }
  .results th { text-align: left; border-bottom: 1px solid #111; padding: 1.5mm 1mm; }
  .results td { padding: 1mm; }
  .panel td { font-weight: bold; padding-top: 3mm; border-bottom: 0.5px solid #999; }
  .flag { font-weight: bold; }
  footer { margin-top: 10mm; font-size: 8pt; color: #555; }
</style>
</head>
<body>
<header>
  <h1>{{ report.lab_name }}</h1>
  <div class="sub">Laboratory report</div>
</header>
<table class="meta">
  <tr>
    <td>{{ labels.PATIENT_NAME }}: {{ report.patient_name.text }}</td>
    <td>{{ labels.BIRTH_DATE }}: {{ report.birth_date.text }}</td>
  </tr>
  <tr>
    <td>{{ labels.SEX }}: {{ report.sex.text }}</td>
    <td>{{ labels.COLLECTION_DATE }}: {{ report.collected_on.text }}</td>
  </tr>
  <tr><td colspan="2">{{ labels.CLINICIAN }}: Dr {{ report.clinician.text }}</td></tr>
</table>
<table class="results">
  <tr><th>Test</th><th>Result</th><th>Units</th><th>Reference range</th><th>Flag</th></tr>
  {% for title, rows in groups %}
  <tr class="panel"><td colspan="5">{{ title }}</td></tr>
  {% for idx, row in rows %}
  <tr>
    <td>{{ row.name.text }}</td>
    <td>{{ row.value.text }}</td>
    <td>{{ row.unit.text if row.unit else "" }}</td>
    <td>{{ row.ref_range.text if row.ref_range else "" }}</td>
    <td class="flag">{{ row.flag.text if row.flag else "" }}</td>
  </tr>
  {% endfor %}
  {% endfor %}
</table>
<footer>Synthetic document generated for software testing. It does not describe a real patient.</footer>
</body>
</html>
