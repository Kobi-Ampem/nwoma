{# Referral letters. Sections render in layout.order, the same order the span locator walks.
   Skeletons override a section's block to change how it looks, never what it contains. #}
<!doctype html>
<html lang="{{ layout.lang }}">
<head>
<meta charset="utf-8">
<style>
  @page { size: A4; margin: 18mm; }
  body { font-family: {{ layout.font | safe }}; font-size: 10pt; color: #111; line-height: 1.35; }
  h2 { font-size: 10.5pt; margin: 4mm 0 1mm 0; }
  ul { margin: 0.5mm 0 0 0; padding-left: 6mm; }
  footer { margin-top: 10mm; font-size: 7.5pt; color: #444; }
  {% block style %}{% endblock %}
</style>
</head>
<body>
{% for section in layout.order %}
{% if section == "header" %}{{ self.header() }}
{% elif section == "patient" %}{{ self.patient() }}
{% elif section == "reason" %}{{ self.reason() }}
{% elif section == "diagnoses" %}{{ self.diagnoses() }}
{% elif section == "medications" %}{{ self.medications() }}
{% elif section == "allergies" %}{{ self.allergies() }}
{% elif section == "sign" %}{{ self.sign() }}
{% endif %}
{% endfor %}
<footer>{{ footer }}</footer>
</body>
</html>
{# Section blocks: defined here, rendered only through self.<name>() above. #}
{% if false %}
{% block header %}<p><b>{{ letter.clinic_name }}</b><br>{{ letter.written }}</p>
<p>{{ h.to }} {{ letter.specialty }}</p>{% endblock %}
{% block patient %}<p>{{ h.name }}{{ layout.separator }}{{ letter.patient_name.text }}<br>
{{ h.dob }}{{ layout.separator }}{{ letter.birth_date.text }}<br>
{{ h.sex }}{{ layout.separator }}{{ letter.sex.text }}</p>{% endblock %}
{% block reason %}<h2>{{ h.reason }}</h2><p>{{ letter.reason.text }}</p>{% endblock %}
{% block diagnoses %}<h2>{{ h.diagnoses }}</h2>
<ul>{% for d in letter.diagnoses %}<li>{{ d.text }}</li>{% endfor %}</ul>{% endblock %}
{% block medications %}<h2>{{ h.medications }}</h2>
<ul>{% for m in letter.medications %}<li>{{ m.name.text }} {{ m.dose.text }} {{ m.frequency.text }}</li>{% endfor %}</ul>{% endblock %}
{% block allergies %}<h2>{{ h.allergies }}</h2>
{% if letter.allergies %}<ul>{% for a in letter.allergies %}<li>{{ a.text }}</li>{% endfor %}</ul>{% else %}<p>{{ h.none }}</p>{% endif %}{% endblock %}
{% block sign %}<p>{{ h.sign }}<br><br>{{ layout.clinician_prefix }}{{ letter.clinician.text }}</p>{% endblock %}
{% endif %}
